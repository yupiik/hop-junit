  <name>Hop JUnit</name>
  <description>JUnit 5 extension framework to test Apache Hop pipelines and workflows, with an engine-agnostic database testing facade (H2 by default, real Oracle via Testcontainers).</description>
  <url>https://github.com/yupiik/hop-junit</url>

  <inceptionYear>2026 - present</inceptionYear>
  <organization>
    <name>Yupiik SAS</name>
    <url>https://www.yupiik.com</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://github.com/yupiik/hop-junit/blob/main/LICENSE</url>
      <distribution>may be downloaded from the Maven repository</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>rmannibucau</id>
      <name>Romain Manni-Bucau</name>
      <roles>
        <role>Contributor</role>
      </roles>
      <timezone>+1</timezone>
    </developer>
    <developer>
      <id>fpapon</id>
      <name>Francois Papon</name>
      <roles>
        <role>Contributor</role>
      </roles>
      <timezone>+1</timezone>
    </developer>
  </developers>

  <modules>
    <module>hop-junit-database-parent</module>
    <module>hop-junit-core</module>
    <module>hop-junit-documentation</module>
  </modules>

  <scm>
    <connection>scm:git:https://github.com/yupiik/hop-junit.git</connection>
    <developerConnection>scm:git:https://github.com/yupiik/hop-junit.git</developerConnection>
    <tag>hop-junit-parent-1.0.0</tag>
    <url>https://github.com/yupiik/hop-junit.git</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    <maven.compiler.release>21</maven.compiler.release>

    <junit.version>6.1.3</junit.version>
    <h2.version>2.5.252</h2.version>
    <dbunit.version>3.5.2</dbunit.version>
    <snakeyaml.version>2.7</snakeyaml.version>
    <jackson.version>2.22.4</jackson.version>
    <poi.version>5.5.1</poi.version>
    <hop.version>2.20.0</hop.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <ojdbc.version>23.9.0.25.07</ojdbc.version>
    <yupiik-tools.version>1.3.1</yupiik-tools.version>
    <slf4j.version>2.0.20</slf4j.version>
    <log4j.version>2.26.1</log4j.version>

    <!--
      Which database implementation the DB-backed tests use. Default is H2 (in-memory, no Docker).
      Downstream consumers activating their own "oracle" Maven profile (-Poracle) switch this to
      ORACLE so the @Database facade resolves the real-Oracle backend (Testcontainers).
    -->
    <database.default.implementation>H2</database.default.implementation>
    <oracle.image>gvenzl/oracle-free:23-slim-faststart@sha256:f5ff19033860d662c821cb04eb10483fa94f14f78eae252d054291ea07028093</oracle.image>

    <hop.coverage.enabled>true</hop.coverage.enabled>
    <hop.coverage.basedir>${project.basedir}</hop.coverage.basedir>
    <hop.coverage.workDir>${project.build.directory}/hop-coverage/${maven.build.timestamp}</hop.coverage.workDir>
    <hop.coverage.rawDir>${hop.coverage.workDir}/raw</hop.coverage.rawDir>
    <hop.coverage.siteDir>${project.build.directory}/hop-coverage/report</hop.coverage.siteDir>
    <hop.coverage.report.format>JSON,HTML,ADOC</hop.coverage.report.format>
    <hop.coverage.failOnWriteError>true</hop.coverage.failOnWriteError>
    <hop.coverage.failOnMalformedReport>true</hop.coverage.failOnMalformedReport>
    <hop.report.adoc.output>${hop.coverage.siteDir}/coverage.adoc</hop.report.adoc.output>
    <hop.coverage.report.adoc.enableMinisiteHopLinking>false</hop.coverage.report.adoc.enableMinisiteHopLinking>
    <hop.coverage.report.html.title>${project.name} - Hop Coverage</hop.coverage.report.html.title>
    <hop.coverage.report.html.subtitle>${project.artifactId} integration coverage</hop.coverage.report.html.subtitle>
    <hop.coverage.report.html.date>${maven.build.timestamp}</hop.coverage.report.html.date>
  </properties>

  <dependencyManagement>
